# Keamanan Direktori Uploads
# Mencegah eksekusi file script berbahaya di folder uploads

Options -Indexes -ExecCGI

<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|pht|pl|py|cgi|sh|bash)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
